<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Yii2">
    <rule ref="vendor/yiisoft/yii2-coding-standards/Yii2">
        <!-- Underscore-prefixed private members are a Yii 1.x leftover and
             conflict with PSR-12; the rest of the Yii2 standard is kept. -->
        <exclude name="Squiz.NamingConventions.ValidVariableName.PrivateNoUnderscore"/>
    </rule>

    <!-- generate relative paths -->
    <arg name="basepath" value="."/>

    <!-- directories to check -->
    <file>assets</file>
    <file>commands</file>
    <file>controllers</file>
    <file>enums</file>
    <file>exceptions</file>
    <file>forms</file>
    <file>interfaces</file>
    <file>services</file>
    <file>support</file>
    <file>mail</file>
    <file>models</file>
    <file>tests</file>
</ruleset>
